#These settings must be configured so that no port or IP is allowed access, except for those deemed secure.

iptables -A INPUT -i enp0s8 -p tcp -s 192.168.0.0/16 --dport 22 -m state --state NEW,ESTABLISHED -j ACCEPT
iptables -A OUTPUT -o enp0s8 -p tcp --sport 22 -m state --state ESTABLISHED -j ACCEPT
iptables -A OUTPUT -o enp0s8 -p udp --sport 53 -m state --state ESTABLISHED -j ACCEPT
iptables -A OUTPUT -o enp0s8 -p udp --sport 53 -m state --state ESTABLISHED -j ACCEPT

iptables-save > /etc/sysconfig/iptables
systemctl enable iptables
